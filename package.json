{
  "name": "airframe",
  "productName": "Airframe",
  "version": "1.5.0",
  "description": "A quiet floating screen for YouTube - launcher, opacity, click-through and screen-share privacy.",
  "main": "main.js",
  "author": "Poshith Nandyala",
  "homepage": "https://github.com/poshithNandyala/airframe",
  "repository": {
    "type": "git",
